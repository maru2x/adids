{
  "description": "Enrich zeek-cowrie-live events with ECS source/destination fields, GeoIP, and ASN metadata.",
  "processors": [
    {
      "set": {
        "field": "source.ip",
        "copy_from": "id.orig_h",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "field": "destination.ip",
        "copy_from": "id.resp_h",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "field": "destination.port",
        "copy_from": "id.resp_p",
        "ignore_empty_value": true
      }
    },
    {
      "geoip": {
        "field": "source.ip",
        "target_field": "source.geo",
        "database_file": "GeoLite2-Country.mmdb",
        "properties": [
          "country_iso_code",
          "country_name",
          "continent_name"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "geoip": {
        "field": "source.ip",
        "target_field": "source.as",
        "database_file": "GeoLite2-ASN.mmdb",
        "properties": [
          "asn",
          "organization_name"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "rename": {
        "field": "source.as.asn",
        "target_field": "source.as.number",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "rename": {
        "field": "source.as.organization_name",
        "target_field": "source.as.organization.name",
        "ignore_missing": true,
        "ignore_failure": true
      }
    }
  ]
}
